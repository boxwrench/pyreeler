# Normalize all text to LF in the repo so byte-level tools (e.g. sync.py's
# filecmp comparison) don't report false drift between checkouts on Windows
# vs. Linux/macOS. Python and Markdown run fine with LF on every platform.
* text=auto eol=lf

# Treat known binary assets as binary (never line-ending converted).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.wav  binary
*.mp3  binary
*.sf2  binary
*.pdf  binary
